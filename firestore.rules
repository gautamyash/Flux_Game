rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // each player can read and write only their own save
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
                         && (request.resource == null || request.resource.data.keys().hasOnly(['data', 'updatedAt']))
                         && (request.resource == null || request.resource.data.data is string)
                         && (request.resource == null || request.resource.data.data.size() < 200000);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
