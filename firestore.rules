rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validDateBoardId(boardId) {
      return boardId.matches('^[0-9]{4}-(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])$')
        || boardId.matches('^[0-9]{4}-(04|06|09|11)-(0[1-9]|[12][0-9]|30)$')
        || boardId.matches('^[0-9]{4}-02-(0[1-9]|1[0-9]|2[0-8])$')
        || boardId.matches('^([0-9]{2}([02468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29$');
    }
    function validBoard(boardId) {
      return boardId == 'global' || validDateBoardId(boardId);
    }
    function googleUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function ownsKey(key) {
      return googleUser()
        && exists(/databases/$(database)/documents/leaderboardProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/leaderboardProfiles/$(request.auth.uid)).data.key == key;
    }
    function matchingSubmission(boardId, runId, key) {
      return existsAfter(/databases/$(database)/documents/leaderboards/$(boardId)/submissions/$(runId))
        && getAfter(/databases/$(database)/documents/leaderboards/$(boardId)/submissions/$(runId)).data.key == key;
    }

    // Private cloud progress remains isolated by Firebase UID.
    match /users/{uid} {
      // Reads have no request.resource. Keep the UID check separate from write validation.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['data', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.updatedAt is int && request.resource.data.updatedAt >= 0
        && request.resource.data.data.size() < 200000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // UID-to-public-key mapping is private. A key is random and never contains account data.
    match /leaderboardProfiles/{uid} {
      allow get: if googleUser() && request.auth.uid == uid;
      allow list: if false;
      allow create: if googleUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['key'])
        && request.resource.data.key is string
        && request.resource.data.key.matches('^[A-Za-z0-9]{20}$');
      allow update: if false;
      allow delete: if googleUser() && request.auth.uid == uid;
    }

    // Public names are looked up by random leaderboard key. They contain no UID or email,
    // and only the Google owner of that key can create, change, or remove the mapping.
    match /leaderboardNames/{key} {
      allow get, list: if googleUser();
      allow create, update: if ownsKey(key)
        && request.resource.data.keys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 24
        && !request.resource.data.displayName.matches('.*@.*');
      allow delete: if ownsKey(key);
    }

    // Scores expose only a random player key and puzzle results; no UID, email, or Google profile fields.
    match /leaderboards/{boardId}/entries/{entryId} {
      allow read: if googleUser() && validBoard(boardId);
      allow create, update: if boardId == 'global'
        && request.resource.data.keys().hasOnly(['key', 'score', 'solved', 'lastRunId', 'updatedAt'])
        && request.resource.data.key == entryId
        && ownsKey(entryId)
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 100000
        && request.resource.data.solved is int && request.resource.data.solved >= 0 && request.resource.data.solved <= 10000
        && (resource == null || request.resource.data.score > resource.data.score
          || (request.resource.data.score == resource.data.score && request.resource.data.solved > resource.data.solved))
        && request.resource.data.lastRunId is string
        && matchingSubmission(boardId, request.resource.data.lastRunId, entryId)
        && request.resource.data.updatedAt is timestamp;
      allow create, update: if validDateBoardId(boardId)
        && request.resource.data.keys().hasOnly(['key', 'stars', 'moves', 'time', 'lastRunId', 'updatedAt'])
        && request.resource.data.key == entryId
        && ownsKey(entryId)
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 3
        && request.resource.data.moves is int && request.resource.data.moves >= 0 && request.resource.data.moves <= 10000
        && request.resource.data.time is number && request.resource.data.time >= 0 && request.resource.data.time <= 86400
        && (resource == null || request.resource.data.stars > resource.data.stars
          || (request.resource.data.stars == resource.data.stars && request.resource.data.moves < resource.data.moves)
          || (request.resource.data.stars == resource.data.stars && request.resource.data.moves == resource.data.moves && request.resource.data.time < resource.data.time))
        && request.resource.data.lastRunId is string
        && matchingSubmission(boardId, request.resource.data.lastRunId, entryId)
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /leaderboards/{boardId}/submissions/{runId} {
      // Only individual lookups are allowed so the client can deduplicate its stable run ID.
      allow get: if googleUser() && validBoard(boardId);
      allow list: if false;
      allow create: if googleUser() && validBoard(boardId)
        && runId.matches('^[A-Za-z0-9-]{8,64}$')
        && request.resource.data.keys().hasOnly(['key'])
        && request.resource.data.key is string
        && ownsKey(request.resource.data.key)
        && existsAfter(/databases/$(database)/documents/leaderboards/$(boardId)/entries/$(request.resource.data.key))
        && getAfter(/databases/$(database)/documents/leaderboards/$(boardId)/entries/$(request.resource.data.key)).data.key == request.resource.data.key;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
