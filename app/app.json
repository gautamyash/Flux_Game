{
  "expo": {
    "name": "FLUX",
    "slug": "flux",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/ea1cdcd9-460f-4022-a2f9-b08ddb4057b5",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gautamyash.flux"
    },
    "android": {
      "package": "com.gautamyash.flux",
      "adaptiveIcon": {
        "backgroundColor": "#0B7F7A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "edgeToEdgeEnabled": true,
      "allowBackup": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ea1cdcd9-460f-4022-a2f9-b08ddb4057b5"
      }
    },
    "owner": "gautamyash",
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#0B7F7A"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F6F3EE",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#131210"
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-asset"
    ],
    "description": "FLUX: draw one path through every open cell, in number order. Offline puzzle game."
  }
}
